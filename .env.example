# Supabase — значения берутся в дашборде проекта:
# Project Settings → Data API / API Keys
#
# ВАЖНО: это публичный (anon) ключ, он безопасен для фронтенда —
# доступ к данным ограничивается RLS-политиками, а не секретностью ключа.
# Сервисный (service_role) ключ во фронтенд НЕ кладём никогда.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
